# Copie este arquivo para .streamlit/secrets.toml localmente.
# No Streamlit Community Cloud, cole estes valores em Settings > Secrets.
# Nunca versione o arquivo .streamlit/secrets.toml real.

LINKEDIN_ORGANIZATION_URN = "urn:li:organization:YOUR_ORGANIZATION_ID"
LINKEDIN_AD_ACCOUNT_URN = "urn:li:sponsoredAccount:YOUR_AD_ACCOUNT_ID"

LINKEDIN_ORGANIC_ACCESS_TOKEN = "YOUR_ORGANIC_ACCESS_TOKEN"
LINKEDIN_ORGANIC_REFRESH_TOKEN = "YOUR_ORGANIC_REFRESH_TOKEN"
LINKEDIN_ORGANIC_CLIENT_SECRET = "YOUR_ORGANIC_CLIENT_SECRET"
LINKEDIN_ORGANIC_EXPIRES_IN = 5184000

LINKEDIN_PAID_ACCESS_TOKEN = "YOUR_PAID_ACCESS_TOKEN"
LINKEDIN_PAID_REFRESH_TOKEN = "YOUR_PAID_REFRESH_TOKEN"
LINKEDIN_PAID_CLIENT_SECRET = "YOUR_PAID_CLIENT_SECRET"
LINKEDIN_PAID_EXPIRES_IN = 5184000
